# Copy to .env for local overrides. Never commit real values. Local review needs none of these:
# without them the site serves the bundled catalogue (data/fallback-catalogue.json).

# Live catalogue: private Google Sheet, read-only service account (Viewer on this Sheet only).
GOOGLE_SHEET_ID=
# The whole JSON key file content. Secret: mark Sensitive in Vercel.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The approved address, Production only (canonical, robots, sitemap). Leave unset locally and in Preview.
PUBLIC_ORIGIN=
# Optional real contact/correction page.
CORRECTION_URL=

# Bootstrap: bundled catalogue only, no Sheet reads, never indexed, no analytics.
HADES_PRELAUNCH=false
# Optional owner-only Vercel Web Analytics (dashboard only; no visitor figures on the page, no token).
HADES_WEB_ANALYTICS=false
# Sheet check interval in seconds, per server instance and triggered by requests (not a schedule).
# Default 21600 (six hours); minimum 60. Failed reads retry sooner (about once a minute while visits arrive).
REFRESH_SECONDS=21600

# No longer used (removed 27 Sep 2026): BLOB_READ_WRITE_TOKEN, BLOB_STORE_ID, DATABASE_URL, ENGAGEMENT_SECRET,
# ENGAGEMENT_BACKEND, VERCEL_ANALYTICS_TOKEN, VERCEL_PROJECT_ID, VERCEL_TEAM_ID, HADES_ANALYTICS_DEMO,
# ALLOW_SEED_PREVIEW, DATA_DIR.
